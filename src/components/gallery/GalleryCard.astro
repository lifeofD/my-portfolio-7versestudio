<main class="gallery">
  <!-- Lightbox -->
<dialog id="lightbox" class="lightbox">
  <button id="close-lightbox" aria-label="Close">&times;</button>
  
  <!-- Navigation Buttons -->
  <button id="prev-lightbox" class="nav-btn" aria-label="Previous image">&#10094;</button>
  
  <img id="lightbox-img" src="" alt="Expanded view" />
  
  <button id="next-lightbox" class="nav-btn" aria-label="Next image">&#10095;</button>
</dialog>

<!--  Code for images -->
  {images.map((image) => (
    <figure id={image.id} class="gallery-item">
      <img
        src={image.src}
        alt={image.alt}
        loading="lazy"
        decoding="async"
      />
    </figure>
  ))}
</main>


<script>
  const dialog = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const closeBtn = document.getElementById('close-lightbox');
  const prevBtn = document.getElementById('prev-lightbox');
  const nextBtn = document.getElementById('next-lightbox');
  
  // Convert NodeList to an Array so we can easily track the index
  const galleryImages = Array.from(document.querySelectorAll('.gallery-item img'));
  let currentIndex = 0;

  // Reusable function to update the image based on index
  function showImage(index) {
    // Wrap around logic (if at start, go to end. If at end, go to start)
    if (index < 0) index = galleryImages.length - 1;
    if (index >= galleryImages.length) index = 0;
    
    currentIndex = index;
    lightboxImg.src = galleryImages[currentIndex].src;
    lightboxImg.alt = galleryImages[currentIndex].alt;
  }

  // 1. Open Lightbox
  galleryImages.forEach((img, index) => {
    img.addEventListener('click', () => {
      showImage(index);
      dialog.showModal();
    });
  });

  // 2. Button Listeners
  closeBtn.addEventListener('click', () => dialog.close());
  
  prevBtn.addEventListener('click', (e) => {
    e.stopPropagation(); // Prevents the backdrop click from triggering
    showImage(currentIndex - 1);
  });
  
  nextBtn.addEventListener('click', (e) => {
    e.stopPropagation(); // Prevents the backdrop click from triggering
    showImage(currentIndex + 1);
  });

  // 3. Close on backdrop click
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // 4. Keyboard Navigation (Arrow Keys)
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      showImage(currentIndex - 1);
    } else if (e.key === 'ArrowRight') {
      showImage(currentIndex + 1);
    }
    // Note: The 'Escape' key naturally closes the <dialog> without us writing code for it!
  });



    // --- NEW: Touch / Swipe Navigation for Mobile ---
  let touchStartX = 0;
  let touchEndX = 0;

  function handleSwipe() {
    // The user must swipe at least 50 pixels for it to count (prevents accidental taps)
    const swipeThreshold = 50; 
    
    if (touchEndX < touchStartX - swipeThreshold) {
      // Swiped Left -> Show Next Image
      showImage(currentIndex + 1); 
    }
    
    if (touchEndX > touchStartX + swipeThreshold) {
      // Swiped Right -> Show Previous Image
      showImage(currentIndex - 1); 
    }
  }

  // 1. Record where the finger touches down
  dialog.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  // 2. Record where the finger lifts up and calculate the swipe
  dialog.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }, { passive: true });
</script>



<style>

/* Previous base styling (keep this) */
.gallery-item img { cursor: zoom-in; }

/* 1. Force the dialog to act as a full-screen flex container */
dialog.lightbox[open] {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  max-width: 100vw;
  max-height: 100vh;
  margin: 0;
  padding: 0;
  background: transparent;
  
  /* Flexbox perfectly centers the image */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 2. The background blur */
.lightbox::backdrop {
  background: var(--primary-background-70op);
  backdrop-filter: blur(8px);
}

/* 3. The Image */
#lightbox-img {
  /* 85vw leaves room on the left/right for the arrows so they don't overlap! */
  max-width: 85vw; 
  max-height: 90vh;
  object-fit: contain;
  border-radius: 8px;
  display: block;
}

/* 4. Button Styling */
.nav-btn, #close-lightbox {
  position: absolute;
  background: var(--secondary-background);
  color: var(--primary-text-color);
  border: none;
  cursor: pointer;
  z-index: 10;
  transition: all 0.3s ease;
}

.nav-btn:hover, #close-lightbox:hover {
  background: var(--accent-color);
}

@media (max-width: 768px) {
  /* Completely hide the arrows on mobile screens */
  .nav-btn { 
    display: none; 
  }
}

/* 5. Position Buttons relative to the screen edges */
#close-lightbox {
  top: 24px;
  right: 32px;
  font-size: 2.5rem;
  line-height: 1;
  padding: 4px 16px;
  border-radius: 8px;
  background: transparent; /* Makes the X button blend in better */
}

#close-lightbox:hover {
  background: transparent;
  color: var(--accent-color);
  transform: scale(1.1);
}

.nav-btn {
  top: 50%;
  transform: translateY(-50%);
  font-size: 2rem;
  padding: 16px 20px;
  border-radius: 8px;
  backdrop-filter: blur(4px);
}

/* Dock arrows to the left and right of the screen */
#prev-lightbox { left: 24px; }
#next-lightbox { right: 24px; }

/* Move them slightly tighter on mobile */
@media (max-width: 768px) {
  #prev-lightbox { left: 8px; padding: 12px 16px; }
  #next-lightbox { right: 8px; padding: 12px 16px; }
  #lightbox-img { max-width: 95vw; } /* Allow image to be wider on mobile */
}

