<div class="work-wrap">
  <section class="section--all">
    <h2 class="work-heading">
    WORK
  </h2>
  </section>
   <div class="work-slider-wrap">
    <section class="work-slider">
  <div class="slider">
    <div class="slider-track" id="sliderTrack">
      <div class="slide">
        <img src="/leantech.webp" alt="leantech landing page with digital signgae display" />
        <h2 class="project-text">LeanTech</h2>
      </div>

      <div class="slide">
        <img src="/vision-eye-care.webp" alt="doctor standing in its surgery clothes" />
        <h2 class="project-text">Vision Eye Care</h2>
      </div>

      <div class="slide">
        <img src="/kamal-nayan.webp" alt="doctor is checking patient through advance machine" />
        <h2 class="project-text">Kamal Nayan Mithila Aankh Hospital</h2>
      </div>

      <div class="slide">
        <img src="/jamalpur.webp" alt="couple of doctors standing together looking at a patient report" />
        <h2 class="project-text">Jamalpur Netralaya</h2>
      </div>

      <div class="slide">
        <img src="/chitara-eye.webp" alt="doctor is doing detailed examination of patient in a eye machine" />
        <h2 class="project-text">Chitara Eye Foundation</h2>
      </div>

    </div>
  </div>

  <div class="slider-controls">
    <button id="prevBtn" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M15 18L9 12L15 6"
          stroke="var(--primary-text-color)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <button id="nextBtn" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M9 18L15 12L9 6"
          stroke="var(--primary-text-color)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
</section>
  </div>
</div>





<script>
document.addEventListener("DOMContentLoaded", () => {
  const track = document.getElementById("sliderTrack");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");

  // Vanilla JS safety check (fixes 'Object is possibly null' warnings)
  if (!track || !prevBtn || !nextBtn) return;

  const slides = [...track.children];
  let currentIndex = 0;

  function getSlideWidth() {
    const slide = slides[0];
    const gap = parseFloat(window.getComputedStyle(track).gap) || 0;

    // getBoundingClientRect() works on all generic Elements without throwing a TypeScript warning
    return slide.getBoundingClientRect().width + gap;
  }

  function updateSlider() {
    const offset = currentIndex * getSlideWidth();
    track.style.transform = `translateX(-${offset}px)`;
  }

  nextBtn.addEventListener("click", () => {
    currentIndex++;

    if (currentIndex >= slides.length) {
      currentIndex = 0;
    }

    updateSlider();
  });

  prevBtn.addEventListener("click", () => {
    currentIndex--;

    if (currentIndex < 0) {
      currentIndex = slides.length - 1;
    }

    updateSlider();
  });

  window.addEventListener("resize", updateSlider);

  updateSlider();
});
</script>





<style>

  /* MARGIN */

    .section--all {
  padding-inline: 16px; /* applies below 425px */
}

/* 425px → 768px */
@media (min-width: 425px) {
  .section--all {
    padding-inline: clamp(16px, calc(4.66vw - 3.8px), 32px);
  }
}

/* 768px → 1272px */
@media (min-width: 768px) {
  .section--all {
    padding-inline: clamp(32px, calc(10.32vw - 47.3px), 84px);
  }
}

@media (min-width: 1920px) {
  .hero {
    background-image: none;
  }
}


  .work-wrap {
  padding-top: 96px;
  padding-bottom: 96px;
  background-color: var(--secondary-background);
}

.work-slider {
  overflow: hidden;
  position: relative;
}

.work-heading {
  margin-top: 0px;
  margin-bottom: 48px;
  border-bottom-style: solid;
  border-bottom-width: 1px;
  border-bottom-color: var(--secondary-text-color);
  color: var(--primary-text-color);
  font-size: var(--text-lg-size);
  line-height: 18px;
  font-weight: var(--h1-light-weight);
}

.work-slider-wrap {
