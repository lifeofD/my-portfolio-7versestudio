  margin-left: auto;
}

.work-slider {
    width: 100%;
  }

  .slider {
    overflow: hidden;
  }

  .slider-track {
    display: flex;
    gap: 48px;
    transition: transform 0.6s ease;
  }

  .slide {
    flex: 0 0 calc(40% - 24px);
    box-sizing: border-box;
    padding-left: 24px;
    padding-right: 24px;
  }

  @media (max-width: 768px) {
  .slider-track {
    gap: 24px;
  }
  

  .slide {
    flex: 0 0 100%;
    padding-left: 0;
    padding-right: 0;
  }
}

  .slide img {
    width: 100%;
    display: block;
    border-radius: 8px;
    transition:
    transform 0.4s ease;
  }

  .slide:hover img {
  transform: scale(1.05);
}


@media (max-width: 768px) {
  .slide img {
    width: 80%;
    margin-left: 3rem;
  }
}
@media (max-width: 425px) {
